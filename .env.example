# ---------------------------------------------------------------------------
# Copy to `.env` (frontend) and fill with values from your AWS deployment.
# NEVER put AWS access keys or secret keys here. Only public client config.
# ---------------------------------------------------------------------------

# Frontend (frontend/.env) - exposed to the browser, must contain NO secrets
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_AbCdEfGhI
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=assignment-portal-abc123.auth.us-east-1.amazoncognito.com

# Backend / SAM (infrastructure/.env.sam is NOT read automatically; pass with
# `sam build --parameter-overrides` or a deployment script instead)
# PARAMETER_EnvironmentName=dev
# PARAMETER_FrontendOrigin=https://main.d1234567890.amplifyapp.com
# PARAMETER_CallbackURLs=https://main.d1234567890.amplifyapp.com/callback
# PARAMETER_LogoutURLs=https://main.d1234567890.amplifyapp.com/logout
